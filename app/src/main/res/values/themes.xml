<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Sniddle" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/arena_grass</item>
        <!-- Sniddle draws its own night look (SniddleTheme follows the phone's dark
             setting). Without this, a light theme lets Android darken the app by
             itself on top of that ("force dark"), guessing at every colour: the
             menus clashed and the snails' eyes went grey. -->
        <!-- Android 10+ only; older Android never darkens apps by itself. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
