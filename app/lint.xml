<?xml version="1.0" encoding="UTF-8"?>
<!-- Android Lint settings for the app. Every check is on (checkAllWarnings);
     anything switched off here is explained. -->
<lint>
    <!-- Slack Compose rule: Compose strong skipping is on by default (Kotlin 2.0.20+), so
         List parameters no longer stop composables from skipping; wrapping them in
         immutable collections would add a dependency for nothing. -->
    <issue id="ComposeUnstableCollections" severity="ignore" />

    <!-- "A newer version of X is available": these look the versions up online, so a
         release anywhere (Gradle, AGP, any library) failed the next unrelated build.
         Dependabot opens the update PRs instead (.github/dependabot.yml). -->
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
</lint>
