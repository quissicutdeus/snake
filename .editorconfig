root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
# Composable functions are named like types (TitleScreen, KidButton).
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,xml}]
indent_size = 2

[*.xml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
